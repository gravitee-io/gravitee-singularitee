    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os-maven-plugin.version}</version>
            </extension>
        </extensions>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>25</source>
                        <target>25</target>
                        <compilerArgs>
                            <arg>--enable-preview</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>--enable-preview</argLine>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.hubspot.maven.plugins</groupId>
                    <artifactId>prettier-maven-plugin</artifactId>
                    <version>${prettier-maven-plugin.version}</version>
                    <configuration>
                        <printWidth>100</printWidth>
                        <ignoreConfigFile>false</ignoreConfigFile>
                        <inputGlobs>
                            <inputGlob>src/**/*.java</inputGlob>
                        </inputGlobs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.mycila</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license-maven-plugin.version}</version>
                    <configuration>
                        <!-- gravitee-parent configures this through <licenseSets>, and mycila
                             ignores the top-level <excludes> as soon as a license set exists.
                             The whole set therefore has to be restated here: the list below is
                             the parent's, plus examples/scripts.

                             Why exclude it: those Python files are demo snippets people copy
                             into their own project, where a 15-line Apache header on a 40-line
                             script is noise. The repository LICENSE still covers them. -->
                        <licenseSets>
                            <licenseSet>
                                <header>com/mycila/maven/plugin/license/templates/APACHE-2.txt</header>
                                <excludes>
                                    <exclude>examples/scripts/**</exclude>
                                    <exclude>LICENSE.txt</exclude>
                                    <exclude>NOTICE.txt</exclude>
                                    <exclude>**/README</exclude>
                                    <exclude>src/main/packaging/**</exclude>
                                    <exclude>src/test/resources/**</exclude>
                                    <exclude>src/main/resources/**</exclude>
                                    <exclude>src/main/webapp/**</exclude>
                                    <exclude>node_modules/**</exclude>
                                    <exclude>dist/**</exclude>
                                    <exclude>.tmp/**</exclude>
                                    <exclude>.*</exclude>
                                    <exclude>.*/**</exclude>
                                    <exclude>**/*.adoc</exclude>
                                </excludes>
                            </licenseSet>
                        </licenseSets>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <additionalOptions>--enable-preview</additionalOptions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>integration</groups>
                            <argLine>--enable-preview --enable-native-access=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>vllm-integration</id>
            <properties>
                <!--
                  Default venv location: ~/.venv-gravitee-ai/.venv
                  Override with -Dvllm.venv.path=/absolute/path/to/.venv
                  or with VLLM_VENV_PATH env var (same value, no trailing /.venv needed).

                  A backend profile (metal | cuda | cpu) must be activated alongside
                  this profile so that setup-venv.sh runs during 'initialize' and
                  creates the venv before the tests start.

                  Example (Apple Silicon):
                    mvn verify -Pvllm-integration,metal

                  Example (existing venv, skip setup):
                    mvn verify -Pvllm-integration -Dvllm.venv.path=/path/to/.venv
                -->
                <vllm.venv.path>${user.home}/.venv-gravitee-ai/.venv</vllm.venv.path>
                <!-- Enable the setup-venv.sh bootstrap that the backend profiles gate. -->
                <vllm.setupVenv.skip>false</vllm.setupVenv.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>vllm-integration</groups>
                            <argLine>--enable-preview --enable-native-access=ALL-UNNAMED</argLine>
                            <!--
                              CPython's atexit handlers (PyTorch/CUDA cleanup) can segfault
                              after all tests complete and VllmEngine.close() succeeds.
                              The last test calls Runtime.halt(0) immediately after retire
                              to exit cleanly before background threads can crash.
                            -->
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                            <!--
                              VllmEngineBuilder.resolveVenv() reads the system property
                              'vllm4j.venv'. We set it from:
                                1. ${vllm.venv.path}  — set by backend profiles via setup-venv.sh
                                2. ${env.VLLM_VENV_PATH} — manual env-var override (escape hatch)
                              When the env var is unset Maven expands it to the literal string
                              "${env.VLLM_VENV_PATH}" which is not a valid path — resolveVenv()
                              then falls through to check user.dir/.venv and user.home/.venv.
                              The backend profile value always wins when a backend is activated.
                            -->
                            <systemPropertyVariables>
                                <vllm4j.venv>${vllm.venv.path}</vllm4j.venv>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ═══════════════════════════════════════════════════════════════════
             vLLM backend profiles — install vLLM into the shared venv.
             Activate alongside vllm-integration:  -Pvllm-integration,metal
             ═══════════════════════════════════════════════════════════════════ -->

        <!-- Apple Silicon Metal/MLX GPU -->
        <profile>
            <id>metal</id>
            <properties>
                <vllm.backend>metal</vllm.backend>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>setup-venv</id>
                                <phase>initialize</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <skip>${vllm.setupVenv.skip}</skip>
                                    <executable>${maven.multiModuleProjectDirectory}/scripts/setup-venv.sh</executable>
                                    <arguments>
                                        <argument>-d</argument><argument>${user.home}/.venv-gravitee-ai</argument>
                                        <argument>-v</argument><argument>${python.version}</argument>
                                        <argument>-b</argument><argument>${vllm.backend}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- NVIDIA CUDA GPU -->
        <profile>
            <id>cuda</id>
            <properties>
                <vllm.backend>cuda</vllm.backend>
                <!-- NVIDIA build: swap the ONNX Runtime native lib to the CUDA/TensorRT
                     artifact. Requires a CUDA-capable GPU with matching CUDA/cuDNN at runtime. -->
                <onnxruntime.artifactId>onnxruntime_gpu</onnxruntime.artifactId>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>setup-venv</id>
                                <phase>initialize</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <skip>${vllm.setupVenv.skip}</skip>
                                    <executable>${maven.multiModuleProjectDirectory}/scripts/setup-venv.sh</executable>
                                    <arguments>
                                        <argument>-d</argument><argument>${user.home}/.venv-gravitee-ai</argument>
                                        <argument>-v</argument><argument>${python.version}</argument>
                                        <argument>-b</argument><argument>${vllm.backend}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- CPU-only -->
        <profile>
            <id>cpu</id>
            <properties>
                <vllm.backend>cpu</vllm.backend>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>setup-venv</id>
                                <phase>initialize</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <skip>${vllm.setupVenv.skip}</skip>
                                    <executable>${maven.multiModuleProjectDirectory}/scripts/setup-venv.sh</executable>
                                    <arguments>
                                        <argument>-d</argument><argument>${user.home}/.venv-gravitee-ai</argument>
                                        <argument>-v</argument><argument>${python.version}</argument>
                                        <argument>-b</argument><argument>${vllm.backend}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
