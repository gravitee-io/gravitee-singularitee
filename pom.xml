<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gravitee</groupId>
        <artifactId>gravitee-parent</artifactId>
        <version>25.0.0</version>
    </parent>

    <groupId>io.gravitee.singularitee</groupId>
    <artifactId>gravitee-singularitee</artifactId>
    <version>1.2.0</version>
    <packaging>pom</packaging>

    <name>Gravitee.io - Singularitee</name>
    <description>Singularitee - Gravitee's Inference Server: a standalone gRPC server for running LLM inference outside the Gravitee gateway</description>
    <url>https://gravitee.io</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Gravitee ecosystem -->
        <gravitee-bom.version>9.0.2</gravitee-bom.version>
        <gravitee-node.version>9.2.0</gravitee-node.version>

        <!-- Vert.x / gRPC (Vert.x version aligned with gravitee-bom 9.0.0-alpha.2) -->
        <vertx.version>5.0.9</vertx.version>
        <grpc.version>1.72.0</grpc.version>
        <protobuf.version>4.30.2</protobuf.version>
        <protoc-gen-grpc-java.version>${grpc.version}</protoc-gen-grpc-java.version>
        <javax-annotation-api.version>1.3.2</javax-annotation-api.version>

        <!-- Build plugins -->
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>

        <!-- GLiNER4j -->
        <gliner4j.version>1.0.0</gliner4j.version>

        <!-- ONNX Runtime native backend, shared by gravitee-singularitee-inference-onnx and
             gliner4j-core. Defaults to the CPU build ("onnxruntime", which also
             carries CoreML on macOS). The "cuda" profile flips the artifact to
             "onnxruntime_gpu" (CUDA/TensorRT).
             Version is pinned to the one gravitee-singularitee-inference-onnx is built against. -->
        <onnxruntime.version>1.27.0</onnxruntime.version>
        <onnxruntime.artifactId>onnxruntime</onnxruntime.artifactId>

        <!-- jinja4j -->
        <jinja4j.version>1.0.0</jinja4j.version>

        <!-- Python / vLLM integration -->
        <python.version>3.12</python.version>

        <!-- vLLM venv bootstrap (scripts/setup-venv.sh) gate. Skipped by default so
             a backend profile (cuda/metal/cpu) can be used purely to select native
             libs at package time without requiring uv/Python. The vllm-integration
             profile flips this to false so the venv is created before those tests. -->
        <vllm.setupVenv.skip>true</vllm.setupVenv.skip>

        <!-- Skip gravitee arch-rules check — Singularitee uses SLF4J directly, not NodeLoggerFactory -->
        <gravitee.archrules.skip>true</gravitee.archrules.skip>
        <gravitee-kubernetes-client.version>4.0.0-alpha.1</gravitee-kubernetes-client.version>

        <!-- Micrometer — inference metrics (token counters, model-call timers). Not managed by
             gravitee-bom; pinned to the version gravitee-node/Vert.x resolve (bundled in the
             distribution lib) so the engine/grpc modules converge on the same micrometer-core
             that feeds the Prometheus registry. -->
        <micrometer.version>1.15.10</micrometer.version>

        <!-- JSON Schema validation for HTTP API request payloads (OpenAI/Anthropic/Gemini) -->
        <json-schema-validator.version>1.5.9</json-schema-validator.version>
    </properties>

    <modules>
        <module>gravitee-singularitee-inference</module>
        <module>gravitee-singularitee-protocol</module>
        <module>gravitee-singularitee-engine</module>
        <module>gravitee-singularitee-workspace</module>
