ARG CUDA_VERSION=12.9.2
ARG UBUNTU_VERSION=24.04

# Prebuilt llama.cpp CUDA libraries — the slow from-source compile, done once by
# Dockerfile.llama-cuda and reused here. Override with a version-keyed tag; the
# local default lets `docker build -f Dockerfile.cuda` work after building the
# base image with Dockerfile.llama-cuda, e.g.:
#   docker build -f Dockerfile.llama-cuda -t llama-cpp-cuda:local .
#   docker build -f Dockerfile.cuda --build-arg LLAMA_LIBS_IMAGE=llama-cpp-cuda:local .
ARG LLAMA_LIBS_IMAGE=llama-cpp-cuda:local

FROM ${LLAMA_LIBS_IMAGE} AS llama-build

FROM nvidia/cuda:${CUDA_VERSION}-cudnn-runtime-ubuntu${UBUNTU_VERSION} AS runtime
LABEL maintainer="contact@graviteesource.com"
LABEL org.opencontainers.image.source="https://github.com/gravitee-io/gravitee-singularitee"
LABEL org.opencontainers.image.description="Singularitee Gateway - gRPC inference server (CUDA / llama.cpp)"

ENV GRAVITEEIO_HOME=/opt/graviteeio-singularitee

ARG TEMURIN_APT_CODENAME=noble
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      curl ca-certificates gnupg libjemalloc2 libgomp1 tini; \
    install -m 0755 -d /etc/apt/keyrings; \
    curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb ${TEMURIN_APT_CODENAME} main" \
      > /etc/apt/sources.list.d/adoptium.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends temurin-25-jdk; \
    apt-get purge -y --auto-remove gnupg; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r -f graviteeio \
    && useradd -r -g root -d ${GRAVITEEIO_HOME} -s /usr/sbin/nologin graviteeio

COPY --chown=graviteeio:root \
     ./gravitee-singularitee-standalone/gravitee-singularitee-standalone-distribution/target/distribution/ \
     ${GRAVITEEIO_HOME}/

# No workspace is baked into the image. Mount one and point the server at it:
#   -v $PWD/examples:/workspaces:ro \
#   -e GRAVITEE_AI_WORKSPACE_PATH=/workspaces/classifier/pii-gliner.yaml
# Model weights download from HuggingFace to ${gravitee.home}/models on first use.

# CUDA-enabled llama.cpp native libraries. LLAMA_CPP_LIB_PATH makes llamaj.cpp load
# these instead of extracting the JAR's bundled CPU-only set.
ENV LLAMA_CPP_LIB_PATH=${GRAVITEEIO_HOME}/native/llama-cuda
COPY --from=llama-build --chown=graviteeio:root /llama-libs/ ${LLAMA_CPP_LIB_PATH}/

COPY --chown=graviteeio:root docker/cuda/cuda-env.sh    ${GRAVITEEIO_HOME}/bin/cuda-env.sh
COPY --chown=graviteeio:root docker/cuda/entrypoint.sh  ${GRAVITEEIO_HOME}/bin/cuda-entrypoint.sh
RUN chmod 0755 ${GRAVITEEIO_HOME}/bin/cuda-env.sh ${GRAVITEEIO_HOME}/bin/cuda-entrypoint.sh

ENV LD_LIBRARY_PATH=${LLAMA_CPP_LIB_PATH}:/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}

WORKDIR ${GRAVITEEIO_HOME}
EXPOSE 9090

USER graviteeio
ENTRYPOINT ["/usr/bin/tini", "--", "./bin/cuda-entrypoint.sh"]
