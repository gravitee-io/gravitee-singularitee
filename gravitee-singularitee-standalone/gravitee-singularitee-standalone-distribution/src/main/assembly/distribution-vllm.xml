<!--
    vLLM flavour — HF checkpoints through vLLM4j, for the vllm/vllm-openai base
    image which already carries Python, CUDA and vLLM itself.

    Drops llama.cpp, ONNX Runtime and GLiNER — this image runs one engine.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>bin</id>
    <formats>
        <format>dir</format>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <componentDescriptors>
        <componentDescriptor>src/main/assembly/component-layout.xml</componentDescriptor>
    </componentDescriptors>

    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>io.gravitee.*:*:jar</include>
            </includes>
            <excludes>
                <exclude>io.gravitee.llama.cpp:llamaj.cpp</exclude>
                <exclude>io.gravitee.singularitee.inference:gravitee-singularitee-inference-llama-cpp</exclude>
                <exclude>io.gravitee.ai.gliner4j:*</exclude>
                <exclude>io.gravitee.singularitee.inference:gravitee-singularitee-inference-onnx</exclude>
            </excludes>
        </dependencySet>
        <!-- Third-party JARs → lib/ext/ -->
        <dependencySet>
            <outputDirectory>lib/ext</outputDirectory>
            <excludes>
                <exclude>io.gravitee.*:*:jar</exclude>
                <exclude>com.microsoft.onnxruntime:*</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
</assembly>
