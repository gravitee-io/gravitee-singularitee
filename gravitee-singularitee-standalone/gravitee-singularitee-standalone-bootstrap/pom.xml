<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gravitee.singularitee</groupId>
        <artifactId>gravitee-singularitee-standalone</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>gravitee-singularitee-standalone-bootstrap</artifactId>

    <name>Gravitee.io - Singularitee - Standalone - Bootstrap</name>
    <description>Production entry point: two-level classloader setup (lib/ + lib/ext/) that reflectively loads the container</description>

    <!-- No dependencies — Bootstrap runs in the system classloader before any Gravitee code is loaded -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <compilerArgs combine.self="override"/>
                </configuration>
            </plugin>
            <plugin>
                <!-- bin/gravitee.sh launches this jar with `java -jar` — the manifest
                     Main-Class is what makes that work ("no main manifest attribute"
                     otherwise). Bootstrap has no dependencies, so no Class-Path needed:
                     it builds the lib/ + lib/ext/ classloaders itself at runtime. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.gravitee.singularitee.standalone.bootstrap.Bootstrap</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <additionalOptions combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
