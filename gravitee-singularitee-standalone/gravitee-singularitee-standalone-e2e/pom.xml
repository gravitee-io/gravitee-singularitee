<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gravitee.singularitee</groupId>
        <artifactId>gravitee-singularitee-standalone</artifactId>
        <version>1.13.0</version>
    </parent>

    <artifactId>gravitee-singularitee-standalone-e2e</artifactId>

    <name>Gravitee.io - Singularitee - Standalone - End-to-end tests</name>
    <description>Black-box tests: boot the built distribution on a workspace and drive it over HTTP. Each backend runs only when its model is in the models directory or SINGULARITEE_E2E names it.</description>

    <properties>
        <!-- Tests only: nothing to publish. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!-- Opt-in: these tests boot real servers, so they run only with -Pe2e. -->
        <skipTests>true</skipTests>
    </properties>

    <profiles>
        <profile>
            <id>e2e</id>
            <properties>
                <skipTests>false</skipTests>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- Orders the reactor: the distribution is assembled before these tests run. Its
             dependencies stay out of the test classpath, the server runs in its own process. -->
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-standalone-distribution</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
