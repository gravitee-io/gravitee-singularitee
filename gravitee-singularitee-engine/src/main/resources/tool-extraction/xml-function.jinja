{#-
  Qwen3.5-style XML tool-call dialect:
    <function=NAME><parameter=KEY>VALUE</parameter>...</function>

  All parameter values are untyped strings (trimmed, like the legacy parser),
  so every argument is flagged coercible — the client coerces them to their
  declared JSON-schema types.
-#}
{%- set fns = output | regex_findall('(?s)<function=([^>]+)>(.*?)</function>') -%}
[
{%- for fn in fns -%}
{%- set params = fn[1] | regex_findall('(?s)<parameter=([^>]+)>(.*?)</parameter>') -%}
{"name": {{ fn[0] | trim | tojson }}, "arguments": {
{%- for p in params -%}
{{ p[0] | trim | tojson }}: {{ p[1] | trim | tojson }}{{ "," if not loop.last }}
{%- endfor -%}
}, "coerce": true}{{ "," if not loop.last }}
{%- endfor -%}
]
