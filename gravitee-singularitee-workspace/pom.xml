<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gravitee.singularitee</groupId>
        <artifactId>gravitee-singularitee</artifactId>
        <version>1.3.0</version>
    </parent>

    <artifactId>gravitee-singularitee-workspace</artifactId>

    <name>Gravitee.io - Singularitee - Workspace</name>
    <description>YAML workspace parsing: loads pipeline and model definitions from workspace files. Shared by server (grpc) and client-side pipeline execution.</description>

    <dependencies>
        <!-- Protocol (protobuf-generated message types) -->
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-protocol</artifactId>
        </dependency>

        <!-- Engine API: the pipeline/step model the loader produces and the step config codec SPI. -->
        <dependency>
            <groupId>io.gravitee.singularitee.engine.api</groupId>
            <artifactId>gravitee-singularitee-engine-api</artifactId>
        </dependency>

        <!-- Jackson YAML -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing: every example loads through the real step plugin zips, staged under
             target/test-plugins and served by a bootstrapped gravitee plugin registry. -->
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The plugin classes on the test classpath: tests cast configs and the registry resolves them parent-first. -->
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-break</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-embed</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-classify</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-regex-guard</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-guard</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-llm-guard</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-tool-select</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-route</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-loop</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-sub-pipeline</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-todo</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-infer</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-break</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-embed</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-classify</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-regex-guard</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-guard</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-llm-guard</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-tool-select</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-route</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-loop</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-sub-pipeline</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-todo</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gravitee.singularitee</groupId>
            <artifactId>gravitee-singularitee-plugin-infer</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>test</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Stage the step plugin zips for the test registry (see TestStepPlugins). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>stage-step-plugins</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeTypes>zip</includeTypes>
                            <includeGroupIds>io.gravitee.singularitee</includeGroupIds>
                            <outputDirectory>${project.build.directory}/test-plugins</outputDirectory>
                            <stripVersion>false</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <compilerArgs combine.self="override"/>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <additionalOptions combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
