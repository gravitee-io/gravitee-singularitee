#
# ONNX Runtime + GLiNER image (CUDA).
#
# Serves onnx_classifier / onnx_embedding / onnx_reranker / gliner_classifier /
# gliner_ner. Carries neither llama.cpp nor vLLM: the distribution is built with
# -Pdist-onnx, and SingulariteeConfiguration probes the classpath at startup, so
# the absent engines are simply never registered.
#
# Build (the distribution must be assembled first, with the GPU ONNX Runtime):
#   mvn clean install -DskipTests -Pcuda,dist-onnx
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.onnx-cuda -t singularitee-onnx-cuda .
#
# Run:
#   docker run --gpus all -p 9090:9090 -v $PWD/examples:/workspaces singularitee-onnx-cuda
#
# -Pcuda selects onnxruntime_gpu over the CPU build. Without it this image runs,
# but every model falls back to the CPU execution provider.
#

ARG CUDA_VERSION=12.9.2
ARG UBUNTU_VERSION=24.04

FROM nvidia/cuda:${CUDA_VERSION}-cudnn-runtime-ubuntu${UBUNTU_VERSION} AS runtime

LABEL maintainer="contact@graviteesource.com"
LABEL org.opencontainers.image.source="https://github.com/gravitee-io/gravitee-singularitee"
LABEL org.opencontainers.image.description="Singularitee Gateway - gRPC inference server (CUDA / ONNX Runtime + GLiNER)"

ENV GRAVITEEIO_HOME=/opt/graviteeio-singularitee

ARG TEMURIN_APT_CODENAME=noble
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      curl ca-certificates gnupg libjemalloc2 libgomp1 tini; \
    install -m 0755 -d /etc/apt/keyrings; \
    curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb ${TEMURIN_APT_CODENAME} main" \
      > /etc/apt/sources.list.d/adoptium.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends temurin-25-jdk; \
    apt-get purge -y --auto-remove gnupg; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r -f graviteeio \
    && useradd -r -g root -d ${GRAVITEEIO_HOME} -s /usr/sbin/nologin graviteeio

COPY --chown=root:root \
     ./gravitee-singularitee-standalone/gravitee-singularitee-standalone-distribution/target/distribution/ \
     ${GRAVITEEIO_HOME}/

COPY --chown=root:root docker/cuda/cuda-env.sh    ${GRAVITEEIO_HOME}/bin/cuda-env.sh
COPY --chown=root:root docker/cuda/entrypoint.sh  ${GRAVITEEIO_HOME}/bin/cuda-entrypoint.sh
RUN chmod 0755 ${GRAVITEEIO_HOME}/bin/cuda-env.sh ${GRAVITEEIO_HOME}/bin/cuda-entrypoint.sh

# Code is root-owned and read-only to the runtime user, so a compromised process cannot plant a
# plugin, library or script that loads on the next start. Only the directories the server writes
# are owned by graviteeio, group root with group write, for arbitrary runtime uids in group root.
RUN set -eux; \
    chmod -R go-w "${GRAVITEEIO_HOME}"; \
    mkdir -p "${GRAVITEEIO_HOME}/logs" "${GRAVITEEIO_HOME}/models" "${GRAVITEEIO_HOME}/plugins/.work" "/home/graviteeio"; \
    chown graviteeio:root "${GRAVITEEIO_HOME}/logs" "${GRAVITEEIO_HOME}/models" "${GRAVITEEIO_HOME}/plugins/.work" "/home/graviteeio"; \
    chmod 0770 "${GRAVITEEIO_HOME}/logs" "${GRAVITEEIO_HOME}/models" "${GRAVITEEIO_HOME}/plugins/.work" "/home/graviteeio"

# HOME (CUDA kernel cache, Python and HuggingFace caches) lives outside the read-only install.
ENV HOME=/home/graviteeio

# No LLAMA_CPP_LIB_PATH and no VLLM4J_VENV: cuda-env.sh skips both blocks.
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}

WORKDIR ${GRAVITEEIO_HOME}
EXPOSE 9090
USER graviteeio

ENTRYPOINT ["/usr/bin/tini", "--", "./bin/cuda-entrypoint.sh"]
