<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gravitee.singularitee</groupId>
        <artifactId>gravitee-singularitee</artifactId>
        <version>1.1.0</version>
    </parent>

    <groupId>io.gravitee.singularitee.inference</groupId>
    <artifactId>gravitee-singularitee-inference</artifactId>
    <packaging>pom</packaging>

    <name>Gravitee.io - Singularitee - Inference</name>
    <description>Vendored inference libraries (model loading and inference), previously io.gravitee.inference</description>

    <modules>
        <module>gravitee-singularitee-inference-math</module>
        <module>gravitee-singularitee-inference-api</module>
        <module>gravitee-singularitee-inference-onnx</module>
        <module>gravitee-singularitee-inference-llama-cpp</module>
        <module>gravitee-singularitee-inference-vllm</module>
    </modules>

    <build>
        <plugins>
            <!-- Inference tests need the same JVM setup the original gravitee-inference
                 build used: preview features, reflective access for tokenizers/serialization,
                 the incubating Vector API (SIMD math) and native access for llama.cpp/ONNX. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine combine.self="override">-Xmx2048m --enable-preview --enable-native-access=ALL-UNNAMED
                        --add-modules jdk.incubator.vector
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.util.regex=ALL-UNNAMED
                        --add-opens java.base/java.util.stream=ALL-UNNAMED
                        --add-opens java.base/java.net=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
