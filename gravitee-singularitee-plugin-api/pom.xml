<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gravitee.singularitee</groupId>
        <artifactId>gravitee-singularitee</artifactId>
        <version>1.2.1</version>
    </parent>

    <artifactId>gravitee-singularitee-plugin-api</artifactId>

    <name>Gravitee.io - Singularitee - Plugin API</name>
    <description>The step plugin SPI: how a gravitee plugin of type step contributes a step executor and its config codec (or, as type step-decorator, a cross-cutting decorator), built purely on parent-loaded engine APIs.</description>

    <dependencies>
        <dependency>
            <groupId>io.gravitee.singularitee.engine.api</groupId>
            <artifactId>gravitee-singularitee-engine-api</artifactId>
        </dependency>
        <!-- The ChatTemplateRenderer contract referenced by StepExecutorServices; the impl is parent-supplied. -->
        <dependency>
            <groupId>io.gravitee.singularitee.inference</groupId>
            <artifactId>gravitee-singularitee-inference-api</artifactId>
        </dependency>
        <!-- Step plugins are gravitee plugins: registry, manifest and parent-first class loading. -->
        <dependency>
            <groupId>io.gravitee.plugin</groupId>
            <artifactId>gravitee-plugin-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <compilerArgs combine.self="override"/>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <additionalOptions combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
